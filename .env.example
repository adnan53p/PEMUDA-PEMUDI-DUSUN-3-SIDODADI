# Supabase project URL, contoh: https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# RECOMMENDED: gunakan Publishable Key (sb_publishable_...) dari Supabase.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback sementara jika project Anda masih memakai anon key lama.
# Jangan isi dua-duanya jika Publishable Key sudah digunakan.
VITE_SUPABASE_ANON_KEY=

# Nomor WhatsApp publik organisasi dalam format internasional tanpa tanda +.
# Biarkan kosong selama belum ada nomor resmi.
VITE_PUBLIC_WHATSAPP_NUMBER=

# ImageKit tidak membutuhkan key VITE_* di browser.
# IMAGEKIT_PRIVATE_KEY dan IMAGEKIT_URL_ENDPOINT disimpan sebagai Supabase Edge Function secrets.
# Lihat docs/IMAGEKIT_MEDIA_SETUP.md.
